# Environment / secrets
.env
**/.env

# Python
__pycache__/
**/__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Telethon session files (contain auth tokens)
*.session
*.session-journal
.telegram_client.pid

# Node
node_modules/
**/.last_run/

# OS
.DS_Store

# Never track .env variants — a backup of a secrets file is still a secrets file
.env.*
*.env.bak.*
